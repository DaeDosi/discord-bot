[Unit]
Description=Singcup KR view-count poller (outbound only)
After=network-online.target
Wants=network-online.target

[Service]
# oneshot + timer 조합이다. long-running으로 두면 크래시 루프가 Restart=always와
# 맞물려 폭주하고, 회차가 겹칠 수 있다. 여기서는 timer 간격이 자연 상한이 된다.
Type=oneshot
User=krpoller
Group=krpoller
WorkingDirectory=/opt/krpoller
# secret은 파일로만 들어온다. 명령행 인자로 넘기면 ps에 그대로 보인다.
EnvironmentFile=/etc/krpoller/env
# 429의 Retry-After는 다음 실행까지 지켜야 한다. oneshot이라 메모리가 남지 않으므로
# /var/lib/krpoller/state.json 에 시각 하나만 남긴다(systemd가 소유·권한을 만든다).
StateDirectory=krpoller
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/krpoller/kr_poller.py
# 한 회차가 이 시간을 넘기면 강제 종료한다(SIGTERM 전파는 코드가 처리한다).
RuntimeMaxSec=300
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
