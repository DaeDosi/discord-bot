[Unit]
Description=Singcup KR view-count poller (outbound only)
After=network-online.target
Wants=network-online.target

[Service]
# oneshot + timer 조합이다. long-running으로 두면 크래시 루프가 Restart=always와
# 맞물려 폭주하고, 회차가 겹칠 수 있다. 여기서는 timer 간격이 자연 상한이 된다.
Type=oneshot
User=krpoller
Group=krpoller
WorkingDirectory=/opt/krpoller
# secret은 파일로만 들어온다. 명령행 인자로 넘기면 ps에 그대로 보인다.
EnvironmentFile=/etc/krpoller/env
# 429의 Retry-After는 다음 실행까지 지켜야 한다. oneshot이라 메모리가 남지 않으므로
# /var/lib/krpoller/state.json 에 시각 하나만 남긴다(systemd가 소유·권한을 만든다).
StateDirectory=krpoller
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/krpoller/kr_poller.py
# 한 회차가 이 시간을 넘기면 강제 종료한다(SIGTERM 전파는 코드가 처리한다).
#
# `RuntimeMaxSec`이 아니라 `TimeoutStartSec`인 이유: Type=oneshot에서는 ExecStart
# 전체가 "기동" 구간이라 RuntimeMaxSec이 적용되지 않는다. systemd가 실제로
# "RuntimeMaxSec has no effect in combination with Type=oneshot"을 경고하며
# 무시했다 — 즉 지금까지 실행 상한이 사실상 없었다.
#
# 300초는 관측 예산(KRP_OBSERVE_BUDGET_SECONDS 기본 180초)과 결과 제출
# 제한(KRP_RESULTS_TIMEOUT_SECONDS 기본 60초)의 합보다 크고, 서버
# lease(SINGCUP_KRP_LEASE_SECONDS 기본 600초)보다 작다. 그래서 정상 경로는
# 상한에 닿지 않고, 닿더라도 lease가 살아 있어 다음 회차가 회수한다.
TimeoutStartSec=300
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
